{
  "name": "@oxyrlab/neuro-learn",
  "version": "0.1.0",
  "description": "Small, deterministic, allocation-free learning algorithms and neural networks on Float32Array.",
  "keywords": [
    "neural-network",
    "reinforcement",
    "hebbian",
    "rescorla-wagner",
    "eligibility-trace",
    "float32array",
    "deterministic",
    "simulation"
  ],
  "homepage": "https://github.com/oxyrlab/neuro-learn#readme",
  "bugs": {
    "url": "https://github.com/oxyrlab/neuro-learn/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxyrlab/neuro-learn.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "docs:check": "tsx scripts/check-docs.ts",
    "bench": "node --import tsx scripts/benchmark.ts",
    "check:allocation": "node --expose-gc --import tsx scripts/check-allocation.ts",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
